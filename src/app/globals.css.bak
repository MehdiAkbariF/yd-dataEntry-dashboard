@import "tailwindcss";

/* ============================================================
   🎨 DESIGN TOKENS — Yadakchi DataEntry 2.1
   سیستم توکن معنایی، روانشناسی‌شده برای کار طولانی
   ============================================================ */

@theme {
  /* ───── Typography ───── */
  --font-sans: var(--font-iran-yekan), system-ui, sans-serif;
  --font-mono: 'Fira Code', 'Cascadia Code', 'Consolas', monospace;

  /* مقیاس تایپوگرافی — گام ۱.۲۵ از پایهٔ ۱۲px
     (هیچ متنی زیر ۱۲px نیست) */
  --text-2xs: 0.75rem;   /* 12px — فقط badge و timestamp */
  --text-xs:  0.8125rem; /* 13px — بدنهٔ جدول، متن ثانویه */
  --text-sm:  0.875rem;  /* 14px — بدنهٔ فرم، label */
  --text-base:0.9375rem; /* 15px — پاراگراف اصلی */
  --text-lg:  1.0625rem; /* 17px — تیتر بخش */
  --text-xl:  1.25rem;   /* 20px — تیتر صفحه */
  --text-2xl: 1.5rem;    /* 24px — تیتر هدر */
  --text-3xl: 1.875rem;  /* 30px — تیتر بزرگ */

  /* line-height فارسی — بالاتر از لاتین */
  --leading-2xs:  1.6;
  --leading-xs:   1.65;
  --leading-sm:   1.7;
  --leading-base: 1.75;
  --leading-lg:   1.65;
  --leading-xl:   1.55;
  --leading-2xl:  1.4;
  --leading-3xl:  1.3;

  /* ───── Spacing Scale (4px base) ───── */
  --space-0: 0;
  --space-px: 1px;
  --space-0_5: 0.125rem;  /* 2 */
  --space-1:   0.25rem;   /* 4 */
  --space-1_5: 0.375rem;  /* 6 */
  --space-2:   0.5rem;    /* 8 */
  --space-2_5: 0.625rem;  /* 10 */
  --space-3:   0.75rem;   /* 12 */
  --space-4:   1rem;      /* 16 */
  --space-5:   1.25rem;   /* 20 */
  --space-6:   1.5rem;    /* 24 */
  --space-8:   2rem;      /* 32 */
  --space-10:  2.5rem;    /* 40 */
  --space-12:  3rem;      /* 48 */

  /* ───── Control Heights ───── */
  --control-sm: 2rem;     /* 32px — دکمه‌های icon کوچک در toolbar */
  --control-md: 2.5rem;   /* 40px — input/select/button استاندارد */
  --control-lg: 2.75rem;  /* 44px — دکمهٔ اصلی، لمس‌پذیر */

  /* ───── Radius ───── */
  --radius-xs: 0.375rem;  /* 6px — badge */
  --radius-sm: 0.5rem;    /* 8px — button کوچک */
  --radius-md: 0.625rem;  /* 10px — input، button */
  --radius-lg: 0.75rem;   /* 12px — کارت، modal */
  --radius-xl: 1rem;      /* 16px — کارت بزرگ */
  --radius-2xl: 1.25rem;  /* 20px — modal، hero */

  /* ───── Motion ───── */
  --duration-fast: 120ms;
  --duration-normal: 180ms;
  --duration-slow: 280ms;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);

  /* ───── Z-Index Scale ───── */
  --z-base: 0;
  --z-dropdown: 40;
  --z-sticky: 50;
  --z-overlay: 100;
  --z-modal: 200;
  --z-toast: 300;
  --z-tooltip: 400;
}

/* ============================================================
   ☀️ LIGHT MODE — پالت نرم، خوانا در ۱۰ ساعت کار
   سطح‌های لایه‌بندی‌شده، کنتراست AA، accent کم‌خشن
   ============================================================ */
:root {
  color-scheme: light;

  /* ───── Surfaces (0=عمیق‌ترین، 3=روشن‌ترین) ───── */
  --surface-0: #eef0f4;       /* background صفحه */
  --surface-1: #f8f9fb;       /* کارت */
  --surface-2: #ffffff;       /* کارت برجسته */
  --surface-3: #ffffff;       /* modal، popover */

  /* ───── Borders ───── */
  --border-subtle: #e5e8ed;   /* divider داخلی */
  --border-default:#d4d9e1;   /* کارت، input */
  --border-strong: #b8bfca;   /* hover، focus state */

  /* ───── Text ───── */
  --text-primary:   #1a1f2e;
  --text-secondary: #454e60;
  --text-tertiary:  #6b7380;
  --text-disabled:  #a8b0bd;
  --text-inverse:   #ffffff;

  /* ───── Accent (Amber) ───── */
  --accent:         #d97706;  /* amber-600 — قابل خواندن روی سفید */
  --accent-hover:   #b45309;  /* amber-700 */
  --accent-subtle:  #fef3c7;  /* amber-100 — background badge */
  --accent-fg:      #92400e;  /* amber-800 — متن روی subtle */
  --accent-contrast:#ffffff;  /* متن روی accent */

  /* ───── Semantic ───── */
  --success:        #059669;
  --success-subtle: #d1fae5;
  --success-fg:     #065f46;

  --danger:         #dc2626;
  --danger-subtle:  #fee2e2;
  --danger-fg:      #991b1b;

  --info:           #2563eb;
  --info-subtle:    #dbeafe;
  --info-fg:        #1e40af;

  --warning:        #d97706;
  --warning-subtle: #fef3c7;
  --warning-fg:     #92400e;

  /* ───── Focus Ring ───── */
  --ring-color: #d97706;
  --ring-width: 2px;
  --ring-offset: 2px;
  --ring-offset-color: var(--surface-1);

  /* ───── Shadows (نرم، نه تیز) ───── */
  --shadow-sm: 0 1px 2px rgba(16, 24, 40, 0.04);
  --shadow-md: 0 2px 6px rgba(16, 24, 40, 0.06), 0 1px 2px rgba(16, 24, 40, 0.04);
  --shadow-lg: 0 8px 20px rgba(16, 24, 40, 0.08), 0 2px 6px rgba(16, 24, 40, 0.05);
  --shadow-xl: 0 16px 32px rgba(16, 24, 40, 0.12), 0 4px 10px rgba(16, 24, 40, 0.06);

  /* ───── Editor / iframe surfaces ───── */
  --editor-bg: #ffffff;
  --editor-gutter: #f6f7f9;
  --preview-bg: #ffffff;
}

/* ============================================================
   🌙 DARK MODE — چهار لایهٔ ملایم، کنتراست کنترل‌شده
   اختلاف هر لایه ۳-۴٪ نه ۸٪ (سوزاندن چشم در شب)
   ============================================================ */
.dark {
  color-scheme: dark;

  /* ───── Surfaces — لایه‌بندی حرفه‌ای ───── */
  --surface-0: #0e1116;       /* background صفحه */
  --surface-1: #15191f;       /* کارت اصلی */
  --surface-2: #1c2128;       /* کارت برجسته، input */
  --surface-3: #232830;       /* modal، popover، dropdown */

  /* ───── Borders ───── */
  --border-subtle: #252a33;
  --border-default:#2e343d;
  --border-strong: #3f4652;

  /* ───── Text ───── */
  --text-primary:   #e8ebf0;
  --text-secondary: #b6bdc8;
  --text-tertiary:  #8a919e;
  --text-disabled:  #5e6673;
  --text-inverse:   #0e1116;

  /* ───── Accent ───── */
  --accent:         #f59e0b;
  --accent-hover:   #fbbf24;
  --accent-subtle:  rgba(245, 158, 11, 0.14);
  --accent-fg:      #fbbf24;
  --accent-contrast:#0e1116;

  /* ───── Semantic ───── */
  --success:        #10b981;
  --success-subtle: rgba(16, 185, 129, 0.12);
  --success-fg:     #34d399;

  --danger:         #ef4444;
  --danger-subtle:  rgba(239, 68, 68, 0.12);
  --danger-fg:      #f87171;

  --info:           #3b82f6;
  --info-subtle:    rgba(59, 130, 246, 0.12);
  --info-fg:        #60a5fa;

  --warning:        #f59e0b;
  --warning-subtle: rgba(245, 158, 11, 0.12);
  --warning-fg:     #fbbf24;

  /* ───── Focus Ring ───── */
  --ring-color: #f59e0b;
  --ring-offset-color: var(--surface-1);

  /* ───── Shadows (تیره، نامرئی) ───── */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
  --shadow-md: 0 2px 8px rgba(0, 0, 0, 0.35);
  --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.45);
  --shadow-xl: 0 20px 40px rgba(0, 0, 0, 0.55);

  /* ───── Editor ───── */
  --editor-bg: #15191f;
  --editor-gutter: #1c2128;
  --preview-bg: #ffffff;
}

/* ============================================================
   BASE — ریشه، body، typography
   ============================================================ */
* {
  border-color: var(--border-default);
}

html, body {
  background-color: var(--surface-0);
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: 14px;          /* ریشه = 14 نه 16؛ مقیاس rem کوچک‌تر */
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  font-feature-settings: "ss01", "ss02", "cv01";
}

body {
  transition:
    background-color var(--duration-normal) var(--ease-out),
    color var(--duration-normal) var(--ease-out);
}

/* ───── Focus visible — برای کار با کیبورد ───── */
:focus-visible {
  outline: var(--ring-width) solid var(--ring-color);
  outline-offset: var(--ring-offset);
  border-radius: var(--radius-md);
}

/* ───── Selection ───── */
::selection {
  background-color: var(--accent-subtle);
  color: var(--accent-fg);
}

/* ───── Scrollbar — باریک، تم‌پذیر، نه آزاردهنده ───── */
* {
  scrollbar-width: thin;
  scrollbar-color: var(--border-strong) transparent;
}
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: var(--border-strong);
  border-radius: 999px;
  border: 2px solid transparent;
  background-clip: content-box;
}
::-webkit-scrollbar-thumb:hover { background: var(--text-tertiary); background-clip: content-box; }

/* ───── Reduced motion — احترام به ترجیح کاربر ───── */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* ============================================================
   🧩 UTILITY CLASSES — برای استفادهٔ مستقیم در JSX
   (کامپوننت‌ها به این‌ها مهاجرت می‌کنند، نه کلاس‌های هاردکد)
   ============================================================ */

/* ───── Surfaces ───── */
.bg-surface-0 { background-color: var(--surface-0); }
.bg-surface-1 { background-color: var(--surface-1); }
.bg-surface-2 { background-color: var(--surface-2); }
.bg-surface-3 { background-color: var(--surface-3); }

/* ───── Borders ───── */
.border-subtle   { border-color: var(--border-subtle); }
.border-default  { border-color: var(--border-default); }
.border-strong   { border-color: var(--border-strong); }

/* ───── Text ───── */
.text-primary   { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-tertiary  { color: var(--text-tertiary); }
.text-disabled  { color: var(--text-disabled); }
.text-accent    { color: var(--accent); }

/* ───── Accent ───── */
.bg-accent          { background-color: var(--accent); color: var(--accent-contrast); }
.bg-accent-subtle   { background-color: var(--accent-subtle); color: var(--accent-fg); }
.text-accent-fg     { color: var(--accent-fg); }

/* ───── Shadows ───── */
.shadow-token-sm { box-shadow: var(--shadow-sm); }
.shadow-token-md { box-shadow: var(--shadow-md); }
.shadow-token-lg { box-shadow: var(--shadow-lg); }
.shadow-token-xl { box-shadow: var(--shadow-xl); }

/* ============================================================
   🧱 COMPONENT PRIMITIVES
   کلاس‌های ترکیبی برای کاهش تکرار در JSX
   ============================================================ */

/* ───── Card ───── */
.card {
  background-color: var(--surface-1);
  border: 1px solid var(--border-default);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.card-elevated {
  background-color: var(--surface-2);
  border: 1px solid var(--border-default);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}

/* ───── Input / Select / Textarea ───── */
.field {
  width: 100%;
  height: var(--control-md);
  padding: 0 var(--space-3);
  background-color: var(--surface-2);
  border: 1px solid var(--border-default);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  font-size: var(--text-sm);
  line-height: var(--leading-sm);
  transition:
    border-color var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out),
    background-color var(--duration-fast) var(--ease-out);
}

.field::placeholder { color: var(--text-tertiary); }

.field:hover:not(:disabled) {
  border-color: var(--border-strong);
}

.field:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-subtle);
}

.field:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  background-color: var(--surface-1);
}

.field[aria-invalid="true"] {
  border-color: var(--danger);
}
.field[aria-invalid="true"]:focus {
  box-shadow: 0 0 0 3px var(--danger-subtle);
}

textarea.field {
  height: auto;
  min-height: 5rem;
  padding: var(--space-2_5) var(--space-3);
  line-height: var(--leading-base);
  resize: vertical;
}

/* ───── Button variants ───── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  height: var(--control-md);
  padding: 0 var(--space-4);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  cursor: pointer;
  transition:
    background-color var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-out);
  user-select: none;
}

.btn:active:not(:disabled) { transform: scale(0.98); }
.btn:disabled { opacity: 0.5; cursor: not-allowed; }

.btn-primary {
  background-color: var(--accent);
  color: var(--accent-contrast);
  border: 1px solid var(--accent);
}
.btn-primary:hover:not(:disabled) { background-color: var(--accent-hover); border-color: var(--accent-hover); }

.btn-secondary {
  background-color: var(--surface-2);
  color: var(--text-primary);
  border: 1px solid var(--border-default);
}
.btn-secondary:hover:not(:disabled) {
  background-color: var(--surface-3);
  border-color: var(--border-strong);
}

.btn-ghost {
  background-color: transparent;
  color: var(--text-secondary);
  border: 1px solid transparent;
}
.btn-ghost:hover:not(:disabled) {
  background-color: var(--surface-2);
  color: var(--text-primary);
}

.btn-danger {
  background-color: var(--danger-subtle);
  color: var(--danger-fg);
  border: 1px solid transparent;
}
.btn-danger:hover:not(:disabled) {
  background-color: var(--danger);
  color: var(--text-inverse);
}

/* ───── Sizes ───── */
.btn-sm { height: var(--control-sm); padding: 0 var(--space-3); font-size: var(--text-xs); }
.btn-lg { height: var(--control-lg); padding: 0 var(--space-5); font-size: var(--text-base); }

/* ───── Icon button ───── */
.btn-icon {
  width: var(--control-md);
  height: var(--control-md);
  padding: 0;
  border-radius: var(--radius-md);
}

/* ───── Badge ───── */
.badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  padding: 0.125rem var(--space-2);
  border-radius: var(--radius-xs);
  font-size: var(--text-2xs);
  font-weight: 600;
  line-height: var(--leading-2xs);
  border: 1px solid transparent;
}
.badge-success { background: var(--success-subtle); color: var(--success-fg); border-color: transparent; }
.badge-danger  { background: var(--danger-subtle);  color: var(--danger-fg);  border-color: transparent; }
.badge-info    { background: var(--info-subtle);    color: var(--info-fg);    border-color: transparent; }
.badge-warning { background: var(--warning-subtle); color: var(--warning-fg); border-color: transparent; }
.badge-neutral { background: var(--surface-2);      color: var(--text-secondary); border-color: var(--border-default); }

/* ============================================================
   📊 TABLE — چگالی مناسب برای کار طولانی
   ارتفاع ردیف 48px، خط ارتفاع 1.65، پدینگ 12/16
   ============================================================ */
.table-token {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  font-size: var(--text-xs);
  line-height: var(--leading-xs);
}

.table-token thead {
  background-color: var(--surface-0);
  position: sticky;
  top: 0;
  z-index: 1;
}

.table-token thead th {
  padding: var(--space-3) var(--space-4);
  font-size: var(--text-2xs);
  font-weight: 700;
  color: var(--text-tertiary);
  text-align: right;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  border-bottom: 1px solid var(--border-default);
  white-space: nowrap;
}

.table-token tbody td {
  padding: var(--space-3) var(--space-4);
  min-height: 48px;
  color: var(--text-secondary);
  vertical-align: middle;
  border-bottom: 1px solid var(--border-subtle);
}

.table-token tbody tr:last-child td { border-bottom: none; }

.table-token tbody tr {
  transition: background-color var(--duration-fast) var(--ease-out);
}
.table-token tbody tr:hover { background-color: var(--surface-0); }

/* ============================================================
   🧭 DASHBOARD LAYOUT TOKENS
   ============================================================ */
.sidebar-token {
  width: 16rem;              /* 256px */
  background-color: var(--surface-1);
  border-left: 1px solid var(--border-default);
}

.header-token {
  height: 3.5rem;            /* 56px */
  background-color: var(--surface-1);
  border-bottom: 1px solid var(--border-default);
}

.sidebar-link {
  display: flex;
  align-items: center;
  gap: var(--space-2_5);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--text-secondary);
  transition: all var(--duration-fast) var(--ease-out);
  min-height: 36px;
}
.sidebar-link:hover {
  background-color: var(--surface-2);
  color: var(--text-primary);
}
.sidebar-link[data-active="true"] {
  background-color: var(--accent-subtle);
  color: var(--accent-fg);
  font-weight: 700;
}

/* ============================================================
   ✏️ EDITOR SPECIFIC (CodePageEditor, Monaco)
   ============================================================ */
.editor-shell {
  background-color: var(--surface-0);
}
.editor-toolbar {
  min-height: 3rem;
  background-color: var(--surface-1);
  border-bottom: 1px solid var(--border-default);
}
.editor-panel {
  background-color: var(--surface-1);
  border: 1px solid var(--border-default);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.editor-panel-header {
  height: 2.5rem;
  padding: 0 var(--space-3);
  background-color: var(--surface-2);
  border-bottom: 1px solid var(--border-default);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--text-xs);
  font-weight: 600;
}

/* ============================================================
   ProseMirror — ادیتور متنی
   ============================================================ */
.ProseMirror {
  min-height: 380px;
  padding: var(--space-5);
  outline: none;
  direction: rtl;
  text-align: right;
  font-size: var(--text-base);
  line-height: var(--leading-base);
  color: var(--text-primary);
}

.ProseMirror p.is-editor-empty:first-child::before {
  color: var(--text-tertiary);
  content: attr(data-placeholder);
  float: right;
  height: 0;
  pointer-events: none;
}

.ProseMirror h1 {
  font-size: var(--text-2xl);
  font-weight: 800;
  color: var(--accent);
  margin-top: var(--space-6);
  margin-bottom: var(--space-3);
  padding-bottom: var(--space-2);
  border-bottom: 1px solid var(--border-default);
  line-height: var(--leading-2xl);
}

.ProseMirror h2 {
  font-size: var(--text-xl);
  font-weight: 800;
  color: var(--text-primary);
  margin-top: var(--space-5);
  margin-bottom: var(--space-2_5);
  line-height: var(--leading-xl);
}

.ProseMirror h3 {
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--text-primary);
  margin-top: var(--space-4);
  margin-bottom: var(--space-2);
  line-height: var(--leading-lg);
}

.ProseMirror p {
  margin-bottom: var(--space-3);
}

.ProseMirror ul:not([data-type="taskList"]) {
  list-style-type: disc;
  padding-right: var(--space-6);
  margin: var(--space-3) 0;
}

.ProseMirror ol {
  list-style-type: decimal;
  padding-right: var(--space-6);
  margin: var(--space-3) 0;
}

.ProseMirror li {
  margin-bottom: var(--space-1_5);
}

.ProseMirror code {
  background-color: var(--surface-2);
  color: var(--accent-fg);
  padding: 0.15rem 0.4rem;
  border-radius: var(--radius-xs);
  font-family: var(--font-mono);
  font-size: 0.875em;
}

.ProseMirror blockquote {
  border-right: 3px solid var(--accent);
  padding: var(--space-3) var(--space-4);
  margin: var(--space-4) 0;
  font-style: italic;
  color: var(--text-secondary);
  background-color: var(--accent-subtle);
  border-radius: var(--radius-sm) 0 0 var(--radius-sm);
}

.ProseMirror table {
  border-collapse: collapse;
  width: 100%;
  margin: var(--space-4) 0;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1px solid var(--border-default);
}

.ProseMirror td,
.ProseMirror th {
  border: 1px solid var(--border-default);
  padding: var(--space-2_5) var(--space-3);
  font-size: var(--text-sm);
  line-height: var(--leading-sm);
}

.ProseMirror th {
  font-weight: 700;
  background-color: var(--surface-2);
  color: var(--accent-fg);
  text-align: right;
}

.ProseMirror img,
.ProseMirror iframe {
  max-width: 100%;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-default);
  margin: var(--space-4) 0;
}

/* ============================================================
   Puck overrides — با توکن
   ============================================================ */
.Puck {
  direction: rtl;
  font-family: var(--font-sans);
}
.Puck [data-puck-publish] {
  background-color: var(--accent) !important;
  color: var(--accent-contrast) !important;
  border-radius: var(--radius-lg) !important;
  font-weight: 700 !important;
}